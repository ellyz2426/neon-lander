<panel width="420" height="160" backgroundColor="#00112240" borderRadius="8" flexDirection="column" padding="6" gap="4">
  <panel flexDirection="row" justifyContent="space-between" gap="4">
    <panel flexDirection="column" gap="2" width="80">
      <text fontSize="9" color="#44aaff" fontWeight="bold">FUEL</text>
      <panel id="fuel-bar-bg" width="70" height="8" backgroundColor="#113322" borderRadius="3">
        <panel id="fuel-bar" width="70" height="8" backgroundColor="#00ff88" borderRadius="3"></panel>
      </panel>
      <text id="fuel-value" fontSize="11" color="#00ff88" fontWeight="bold">100%</text>
    </panel>
    <panel flexDirection="column" gap="2" alignItems="center" width="50">
      <text fontSize="9" color="#44aaff" fontWeight="bold">ALT</text>
      <text id="alt-value" fontSize="14" color="#ffffff" fontWeight="bold">0.0</text>
    </panel>
    <panel flexDirection="column" gap="2" alignItems="center" width="50">
      <text fontSize="9" color="#44aaff" fontWeight="bold">VX</text>
      <text id="vx-value" fontSize="14" color="#ffffff" fontWeight="bold">0.0</text>
    </panel>
    <panel flexDirection="column" gap="2" alignItems="center" width="50">
      <text fontSize="9" color="#44aaff" fontWeight="bold">VY</text>
      <text id="vy-value" fontSize="14" color="#ffffff" fontWeight="bold">0.0</text>
    </panel>
    <panel flexDirection="column" gap="2" alignItems="center" width="45">
      <text fontSize="9" color="#44aaff" fontWeight="bold">ANGLE</text>
      <text id="angle-value" fontSize="14" color="#ffffff" fontWeight="bold">0</text>
    </panel>
    <panel flexDirection="column" gap="2" alignItems="center" width="45">
      <text fontSize="9" color="#ffcc44" fontWeight="bold">WIND</text>
      <text id="wind-value" fontSize="14" color="#ffcc44" fontWeight="bold">0.0</text>
    </panel>
  </panel>
  <panel flexDirection="row" justifyContent="space-between" alignItems="center" paddingLeft="4" paddingRight="4">
    <panel flexDirection="row" gap="6" alignItems="center">
      <text id="score-label" fontSize="10" color="#ff8844" fontWeight="bold">SCORE</text>
      <text id="score-value" fontSize="16" color="#ff8844" fontWeight="bold">0</text>
    </panel>
    <text id="countdown-text" fontSize="20" color="#44ffaa" fontWeight="bold"></text>
    <panel flexDirection="row" gap="8" alignItems="center">
      <text id="status-indicator" fontSize="10" color="#44ff44" fontWeight="bold">SAFE</text>
      <panel flexDirection="row" gap="4" alignItems="center">
        <text fontSize="10" color="#ff4466" fontWeight="bold">LVL</text>
        <text id="level-value" fontSize="14" color="#ff4466" fontWeight="bold">1</text>
      </panel>
      <panel flexDirection="row" gap="4" alignItems="center">
        <text fontSize="10" color="#ff4466" fontWeight="bold">HP</text>
        <text id="lives-value" fontSize="14" color="#ff4466" fontWeight="bold">3</text>
      </panel>
    </panel>
  </panel>
  <panel flexDirection="row" justifyContent="space-between" alignItems="center" paddingLeft="4" paddingRight="4">
    <text id="powerup-status" fontSize="9" color="#cc44ff" fontWeight="bold"></text>
    <text id="combo-text" fontSize="10" color="#ffcc00" fontWeight="bold"></text>
  </panel>
</panel>
